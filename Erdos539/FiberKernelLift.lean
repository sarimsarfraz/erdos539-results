import Erdos539.FiniteKernelEntropy
import Erdos539.FiniteConditionalLaws

namespace Erdos539Geometry
noncomputable section
open scoped BigOperators Classical

/-- Glue stochastic kernels from the actual fibers of a finite map.
Every input uses its own original fiber, so no point labels are changed. -/
def fiberKernel {α β : Type*} [Fintype α] (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b}) : FiniteMarkovKernel α α where
  weight a := finitePush ((K (f a)).weight ⟨a, rfl⟩) Subtype.val
  nonneg a := finitePush_nonneg _ _ ((K (f a)).nonneg ⟨a, rfl⟩)
  sum_one a := by rw [finitePush_sum, (K (f a)).sum_one]

theorem fiberKernel_row {α β : Type*} [Fintype α] (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b})
    (b : β) (a : {a // f a = b}) :
    (fiberKernel f K).weight a.val = finitePush ((K b).weight a) Subtype.val := by
  obtain ⟨a, ha⟩ := a
  cases ha
  rfl

theorem fiberKernel_weight_same {α β : Type*} [Fintype α] (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b})
    (b : β) (a x : {a // f a = b}) :
    (fiberKernel f K).weight a.val x.val = (K b).weight a x := by
  rw [fiberKernel_row f K b a]
  exact finitePush_apply_injective _ Subtype.val Subtype.val_injective x

theorem fiberKernel_weight_zero {α β : Type*} [Fintype α] (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b})
    (a x : α) (h : f x ≠ f a) : (fiberKernel f K).weight a x = 0 := by
  apply finitePush_eq_zero_of_fiber_zero
  intro y hy
  have he := y.property
  rw [hy] at he
  exact False.elim (h he)

theorem fiberKernel_support {α β : Type*} [Fintype α] (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b})
    (a x : α) (h : (fiberKernel f K).weight a x ≠ 0) : f x = f a := by
  by_contra hn
  exact h (fiberKernel_weight_zero f K a x hn)

/-- Stationarity of every actual conditional fiber law gives stationarity
of the original law after gluing; zero-mass fibers need no deletion. -/
theorem fiberKernel_preserves {α β : Type*} [Fintype α] [Fintype β]
    (ν : α → ℝ) (hν : ∀ a, 0 ≤ ν a) (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b})
    (hK : ∀ b, (K b).Preserves (conditionalWeight ν f b)) :
    (fiberKernel f K).Preserves ν := by
  funext x
  rw [finitePush_snd]
  change (∑ a, ν a * (fiberKernel f K).weight a x) = ν x
  rw [← Fintype.sum_fiberwise f (fun a ↦ ν a * (fiberKernel f K).weight a x)]
  rw [Finset.sum_eq_single (f x)]
  · let y : {a // f a = f x} := ⟨x, rfl⟩
    calc
      _ = finitePush ν f (f x) * ∑ a, conditionalWeight ν f (f x) a * (K (f x)).weight a y := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro a _
        have he := fiberKernel_weight_same f K (f x) a y
        change (fiberKernel f K).weight a.val x = _ at he
        rw [he, ← conditionalWeight_mul_mass ν hν f (f x) a]
        ring
      _ = finitePush ν f (f x) * conditionalWeight ν f (f x) y := by
        have he := congrFun (hK (f x)) y
        rw [finitePush_snd] at he
        simp only [FiniteMarkovKernel.joint] at he
        rw [he]
      _ = ν x := conditionalWeight_mul_mass ν hν f (f x) y
  · intro b _ hb
    apply Finset.sum_eq_zero
    intro a _
    have hn : f x ≠ f a.val := by rw [a.property]; exact Ne.symm hb
    rw [fiberKernel_weight_zero f K a.val x hn, mul_zero]
  · simp

/-- Exact decomposition of the entropy generated by a glued transition
into the actual conditional fiber laws. -/
theorem fiberKernel_output_average {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (ν : α → ℝ) (hν : ∀ a, 0 ≤ ν a) (f : α → β)
    (K : ∀ b, FiniteMarkovKernel {a // f a = b} {a // f a = b}) (channel : α → α → γ) :
    (∑ a, ν a * finiteEntropy (finitePush ((fiberKernel f K).weight a) (channel a))) =
      ∑ b, finitePush ν f b * ∑ a : {a // f a = b}, conditionalWeight ν f b a *
        finiteEntropy (finitePush ((K b).weight a) (fun x ↦ channel a.val x.val)) := by
  rw [← Fintype.sum_fiberwise f (fun a ↦ ν a * finiteEntropy (finitePush ((fiberKernel f K).weight a) (channel a)))]
  apply Finset.sum_congr rfl
  intro b _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [fiberKernel_row f K b a, finitePush_comp, ← conditionalWeight_mul_mass ν hν f b a]
  simp only [Function.comp_def]
  ring

end
end Erdos539Geometry
