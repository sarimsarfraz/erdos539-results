/-- Every displayed coefficient is a nonnegative integer. -/
theorem rationalSidonCertificate_nonneg {t y : ℝ} (ht : 0 ≤ t) (hy : 0 ≤ y) :
    0 ≤ rationalSidonCertificate t y := by
  unfold rationalSidonCertificate
  positivity

set_option maxRecDepth 8192 in
set_option maxHeartbeats 4000000 in
/-- Exact degree-130 polynomial identity, checked by the kernel through
ring normalization; no external arithmetic oracle is used. -/
theorem rationalSidonCertificate_identity (t y : ℝ) :
    (((y + t) ^ 10 + y ^ 10) ^ 13 -
      ((y + t) ^ 26 + 4 * (y + t) ^ 13 * y ^ 13 + y ^ 26) ^ 5) =
      rationalSidonCertificate t y := by
  unfold rationalSidonCertificate
  ring

/-- The ordered scalar case follows by substituting t=x-y. -/
theorem rational_sidon_polynomial_ordered {x y : ℝ} (hy : 0 ≤ y) (hxy : y ≤ x) :
    (x ^ 26 + 4 * x ^ 13 * y ^ 13 + y ^ 26) ^ 5 ≤ (x ^ 10 + y ^ 10) ^ 13 := by
  have h := rationalSidonCertificate_nonneg (sub_nonneg.mpr hxy) hy
  rw [← rationalSidonCertificate_identity] at h
  have he : y + (x - y) = x := by ring
  rw [he] at h
  exact sub_nonneg.mp h

/-- The exact rational polynomial inequality for all nonnegative inputs. -/
theorem rational_sidon_polynomial {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (x ^ 26 + 4 * x ^ 13 * y ^ 13 + y ^ 26) ^ 5 ≤ (x ^ 10 + y ^ 10) ^ 13 := by
  rcases le_total y x with h | h
  · exact rational_sidon_polynomial_ordered hy h
  · have he : x ^ 26 + 4 * x ^ 13 * y ^ 13 + y ^ 26 =
        y ^ 26 + 4 * y ^ 13 * x ^ 13 + x ^ 26 := by ring
    rw [he, add_comm (x ^ 10)]
    exact rational_sidon_polynomial_ordered hx h

